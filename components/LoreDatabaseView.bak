                    const descMatch = (l.description || '').toLowerCase().includes(search);
                    const typeMatch = (l.details?.type || '').toLowerCase().includes(search);
                    const climateMatch = (l.details?.climate || '').toLowerCase().includes(search);
                    const landmarksMatch = (l.details?.landmarks || '').toLowerCase().includes(search);
                    const rulerMatch = (l.details?.ruler || '').toLowerCase().includes(search);
                                        if (!titleMatch && !descMatch && !typeMatch && !climateMatch && !landmarksMatch && !rulerMatch) {
                      return false;}}
/* Level Filter */
                  if (listLevelFilter !== 'all') {
                    if (l.details?.mapLevel !== listLevelFilter) return false;}
/* Role Filter */
                  if (listTypeFilter !== 'all') {
                    const isStory = !!l.details?.associatedEventStepId;
                    if (listTypeFilter === 'story' && !isStory) return false;
                    if (listTypeFilter === 'checkpoint' && isStory) return false;}
                  return true;});
                if (filteredPlaces.length === 0) {
