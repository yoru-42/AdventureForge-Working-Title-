                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-bold uppercase">Regierungsform / Machtstrukturen</label>                      <input                         type="text"                         placeholder="z.B. Absolute Monarchie, Weltregierung, Shogunat, Kaiserreich"                        className="bg-slate-950 border border-slate-800 rounded-xl p-3 text-white text-sm outline-none focus:border-amber-500"                        value={
