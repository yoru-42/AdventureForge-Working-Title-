                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Belohnung / Auswirkung</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.rewards || ''}
                        onChange={(e) => updateDetail('rewards', e.target.value)}
                        placeholder="z.B. 500 Gold, Zorn der Stadtwache..."                      />                    </div>                  </>                )}
                {/* Geheimnisse Stufen */}
                <div className="col-span-1 md:col-span-2 flex flex-col gap-2 bg-slate-950/60 p-3 rounded-xl border border-slate-800">                  <label className="text-xs text-amber-500 font-bold uppercase tracking-wider flex items-center gap-1.5">                    <i className="fa-solid fa-user-secret text-amber-400">
</i>                    <span>Geheimnisse (Auskunftsstufen)</span>                  </label>                  <div className="grid grid-cols-1 md:grid-cols-3 gap-2">                    <input                      type="text"                      className="bg-slate-900 border border-slate-800 rounded-lg p-2 text-slate-200 text-xs placeholder-slate-600 focus:border-amber-500 outline-none"                      value={
editForm.secretsStage1 || ''}
                      onChange={(e) => setEditForm(prev => ({...prev, secretsStage1: e.target.value }))}
                      placeholder="Stufe 1 (Geringes Geheimnis)"                    />                    <input                      type="text"                      className="bg-slate-900 border border-slate-800 rounded-lg p-2 text-slate-200 text-xs placeholder-slate-600 focus:border-amber-500 outline-none"                      value={
editForm.secretsStage2 || ''}
                      onChange={(e) => setEditForm(prev => ({...prev, secretsStage2: e.target.value }))}
                      placeholder="Stufe 2 (Mittleres Geheimnis)"                    />                    <input                      type="text"                      className="bg-slate-900 border border-slate-800 rounded-lg p-2 text-slate-200 text-xs placeholder-slate-600 focus:border-amber-500 outline-none"                      value={
editForm.secretsStage3 || ''}
                      onChange={(e) => setEditForm(prev => ({...prev, secretsStage3: e.target.value }))}
                      placeholder="Stufe 3 (Dunkles Geheimnis)"                    />                  </div>                </div>              </div>              {/* Actions Footer */}
              <div className="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-800">                <button                  type="button"                  onClick={
handleGenerateImage}
                  disabled={
