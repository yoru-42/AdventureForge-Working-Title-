{
                                width: `${nodeSize}px`,                                height: `${nodeSize}px`                              }}
                              className={
`rounded-full flex items-center justify-center transition-all duration-300 shadow-xl border-2 ${                                terrainPreset ? (                                  isSelected                                     ? `${
