t="4.5" rx="1.5" fill="#f5eeda" stroke="#baa684" strokeWidth="0.2" opacity="0.9" />
                              <text x="50" y="13.2" fill="#5c4327" fontSize="2.2" fontWeight="bold" textAnchor="middle" letterSpacing="0.05" fontFamily="sans-serif">NORTH BLUE</text>                              {/* West Blue (Left) */}                              <rect x="6" y="47" width="18" height="4.5" rx="1.5" fill="#f5eeda" stroke="#baa684" strokeWidth="0.2" opacity="0.9" />
                              <text x="15" y="50.2" fill="#5c4327" fontSize="2.2" fontWeight="bold" textAnchor="middle" letterSpacing="0.05" fontFamily="sans-serif">WEST BLUE</text>                              {/* East Blue (Right) */}                              <rect x="76" y="47" width="18" height="4.5" rx="1.5" fill="#f5eeda" stroke="#baa684" strokeWidth="0.2" opacity="0.9" />
                              <text x="85" y="50.2" fill="#5c4327" fontSize="2.2" fontWeight="bold" textAnchor="middle" letterSpacing="0.05" fontFamily="sans-serif">EAST BLUE</text>                              {/* South Blue (Bottom) */}                              <rect x="40" y="86" width="20" height="4.5" rx="1.5" fill="#f5eeda" stroke="#baa684" strokeWidth="0.2" opacity="0.9" />
                              <text x="50" y="89.2" fill="#5c4327" fontSize="2.2" fontWeight="bold" textAnchor="middle" letterSpacing="0.05" fontFamily="sans-serif">SOUTH BLUE</text>                                                            {/* Intersection Point: Reverse Mountain */}                              <circle cx="50" cy="50" r="3.5" fill="#d2691e" stroke="#8a3a27" strokeWidth="0.4" />
                              <circle cx="50" cy="50" r="2" fill="#fcf8f2" stroke="#d2691e" strokeWidth="0.3" />
                              <text x="50" y="45.5" fill="#8a3a27" fontSize="1.8" fontWeight="bold" textAnchor="middle" fontFamily="sans-serif">REVERSE MOUNTAIN</text>                            </g>                          )}                          {/* Elegant Compass Rose bottom right */}                          <g transform="translate(85, 82) scale(0.6)">                            <circle cx="0" cy="0" r="12" fill="none" stroke="#a47c5c" strokeWidth="0.3" opacity="0.6" />
                            <circle cx="0" cy="0" r="10" fill="none" stroke="#a47c5c" strokeWidth="0.15" strokeDasharray="1,1" />
                            {/* Needle axes */}                            <line x1="-15" y1="0" x2="15" y2="0" stroke="#8c5a3c" strokeWidth="0.25" opacity="0.7" />
                            <line x1="0" y1="-15" x2="0" y2="15" stroke="#8c5a3c" strokeWidth="0.25" opacity="0.7" />
                            {/* Points of Compass */}                            <polygon points="0,-14 -3,-3 0,0" fill="#8c5a3c" />
                            <polygon points="0,-14 3,-3 0,0" fill="#b47850" />
                            <polygon points="0,14 -3,3 0,0" fill="#b47850" />
                            <polygon points="0,14 3,3 0,0" fill="#8c5a3c" />
                            <polygon points="-14,0 -3,-3 0,0" fill="#8c5a3c" />
                            <polygon points="-14,0 -3,3 0,0" fill="#b47850" />
                            <polygon points="14,0 3,-3 0,0" fill="#b47850" />
                            <polygon points="14,0 3,3 0,0" fill="#8c5a3c" />
                            {/* Labels */}                            <text x="0" y="-15.5" fill="#8c5a3c" fontSize="2.8" fontWeight="bold" textAnchor="middle" className="font-sans">N</text>                            <text x="0" y="18" fill="#8c5a3c" fontSize="2.5" textAnchor="middle" className="font-sans">S</text>                            <text x="17.5" y="1" fill="#8c5a3c" fontSize="2.5" textAnchor="middle" className="font-sans">O</text>                            <text x="-17.5" y="1" fill="#8c5a3c" fontSize="2.5" textAnchor="middle" className="font-sans">W</text>                          </g>                          {/* Decorative old ship icon floating on map */}                          <g transform="translate(18, 25) scale(0.35)" className="animate-pulse duration-[8000ms]">                            <path d="M5,10 C12,10 15,15 25,14 C35,13 38,8 45,9 C43,15 35,22 25,22 C12,22 5,16 5,10 Z" fill="#d0b99a" stroke="#8c5a3c" strokeWidth="0.5" />
                            {/* Sails */}                            <path d="M15,9 C15,3 22,2 22,1 C22,5 16,7 15,9 Z" fill="#fcf8f2" stroke="#8c5a3c" strokeWidth="0.4" />
