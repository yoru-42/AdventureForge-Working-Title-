</i>                    <span>Kampfeffekte</span>                    {activePlacingEffect && (                      <span className="ml-1 bg-slate-950/90 border border-amber-500 text-amber-400 text-[9px] px-1.5 py-0.5 rounded-md flex items-center gap-1 font-sans font-black uppercase">                        <span>Aktiv: {activePlacingEffect}</span>                      </span>                    )}                    {!activePlacingEffect && (                      <i className={`fa-solid fa-chevron-down text-[9px] transition-transform duration-200 ${isCombatDropdownOpen ? 'rotate-180' : ''}`}>
</i>                    )}                  </button>                  {isCombatDropdownOpen && !activePlacingEffect && (                    <div className="absolute left-0 mt-2 w-64 bg-slate-950 border border-slate-800 rounded-xl p-3.5 shadow-2xl z-[100] flex flex-col gap-2 animate-in fade-in slide-in-from-top-2 duration-150" id="combat-effects-dropdown">                      <div className="flex items-center gap-1.5 border-b border-slate-800 pb-1.5 mb-1">                        <i className="fa-solid fa-burst text-amber-500 text-xs">
</i>                        <span className="text-[10px] font-black text-slate-200 uppercase tracking-wider font-sans">Kampfeffekt-Auren</span>                      </div>                      <p className="text-[9px] text-slate-400 leading-normal mb-2">                        Wähle einen elementaren Effekt. Klicke danach auf eine freie Stelle der Weltkarte, um dort eine dynamische Kampfzone zu entfesseln!                      </p>                                            <div className="flex flex-col gap-1.5">                        <button                          type="button"                          onClick={() =>
