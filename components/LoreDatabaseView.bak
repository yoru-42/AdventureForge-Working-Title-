{                            setActivePlacingEffect('eis');                            setIsCombatDropdownOpen(false);                          }}                          className="w-full text-left p-2 rounded-lg text-xs text-slate-300 hover:bg-sky-950/40 hover:text-sky-300 transition-colors flex items-center gap-2.5 font-bold cursor-pointer border border-transparent hover:border-sky-900/40"                        >                          <i className="fa-solid fa-snowflake text-sky-400 text-xs">
</i>                          <div>                            <span className="block text-[11px]">Eisiger Froststurm</span>                            <span className="block text-[8px] text-slate-500 font-normal">Gletscherfrost &amp; gefrorene Barrieren</span>                          </div>                        </button>                        <button                          type="button"                          onClick={() =>
{                            setActivePlacingEffect('lightning');                            setIsCombatDropdownOpen(false);                          }}                          className="w-full text-left p-2 rounded-lg text-xs text-slate-300 hover:bg-purple-950/40 hover:text-purple-300 transition-colors flex items-center gap-2.5 font-bold cursor-pointer border border-transparent hover:border-purple-900/40"                        >                          <i className="fa-solid fa-bolt text-purple-400 text-xs animate-bounce">
</i>                          <div>                            <span className="block text-[11px]">Elektrisches Gewitter</span>                            <span className="block text-[8px] text-slate-500 font-normal">Blitzschläge &amp; magnetische Stürme</span>                          </div>                        </button>                        <button                          type="button"                          onClick={() =>
{                            setActivePlacingEffect('poison');                            setIsCombatDropdownOpen(false);                          }}                          className="w-full text-left p-2 rounded-lg text-xs text-slate-300 hover:bg-emerald-950/40 hover:text-emerald-300 transition-colors flex items-center gap-2.5 font-bold cursor-pointer border border-transparent hover:border-emerald-900/40"                        >                          <i className="fa-solid fa-biohazard text-emerald-400 text-xs animate-pulse">
</i>                          <div>                            <span className="block text-[11px]">Toxische Giftwolke</span>                            <span className="block text-[8px] text-slate-500 font-normal">Ätzende Nebelschwaden &amp; Seuchennebel</span>                          </div>                        </button>                      </div>                    </div>                  )}                </div>              </div>              {/* Right Side: Zoom Controls & Synchronize Action */}              <div className="flex flex-wrap items-center gap-3">                                {/* Zoom Controls Bar */}                <div className="flex items-center gap-1 bg-slate-950 border border-slate-800 rounded-xl p-1 shadow-md" onPointerDown={(e) => e.stopPropagation()}>                  <button                    type="button"                    onClick={() => handleZoom(Math.max(0.5, parseFloat((mapScale - 0.25).toFixed(2))))}                    className="w-7 h-7 rounded-lg hover:bg-slate-850 text-slate-300 flex items-center justify-center transition-colors border border-transparent hover:border-slate-700 cursor-pointer"                    title="Herauszoomen"                  >                    <i className="fa-solid fa-minus text-xs">
