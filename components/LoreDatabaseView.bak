target.id}
 className="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 flex flex-col gap-3 shadow-lg">                          <div className="flex items-center gap-3 pb-2 border-b border-slate-800">                            <div className="w-9 h-9 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center overflow-hidden shrink-0">                              {
target.image ? (                                <img src={
target.image}
 alt={
target.title}
 className="w-full h-full object-cover" referrerPolicy="no-referrer" />                              ) : (                                <i className={
