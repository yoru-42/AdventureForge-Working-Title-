            <div className="bg-slate-950/80 p-4 sm:p-5 rounded-3xl border border-slate-800 shadow-xl flex flex-col gap-4 relative overflow-hidden">              <div className="absolute top-0 right-0 w-32 h-32 bg-amber-600/5 rounded-full blur-2xl pointer-events-none">
</div>                            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">                <div>                  <h4 className="text-xs font-black text-amber-500 uppercase tracking-widest flex items-center gap-1.5 animate-pulse">                    <i className="fa-solid fa-route text-xs text-amber-500">
</i> Hierarchischer Reisezeit- & Distanzrechner                  </h4>                  <p className="text-[10px] text-slate-400 mt-0.5">                    Gitternetz-Logik:                     <span className="text-amber-400 font-semibold"> Welt (1 K. ≈ 50 km)</span> |                     <span className="text-emerald-400 font-semibold"> Region (1 K. ≈ 5 km)</span> |                     <span className="text-sky-400 font-semibold"> Orte (1 K. ≈ 50 m)</span> |                    <span className="text-violet-400 font-semibold"> Gebäude (1 K. ≈ 5 m)</span>                  </p>                </div>                <div className="bg-slate-900/80 border border-slate-800 px-2 py-1 rounded-xl flex items-center gap-1.5 shrink-0 self-start sm:self-auto">                  <span className="text-[9px] text-slate-400 uppercase font-mono tracking-wider">Ebene:</span>                  <span className={
