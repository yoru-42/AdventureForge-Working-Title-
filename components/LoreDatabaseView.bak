er beim Komprimieren des hochgeladenen Bildes.");        }      }    };    reader.readAsDataURL(file);  };  const uniqueLore = useMemo(() => {    const seen = new Set<string>();    const res: LoreEntry[] = [];    for (const item of (lore || [])) {      if (item && item.id && !seen.has(item.id)) {        seen.add(item.id);        res.push(item);      }    }    return res;  }, [lore]);  const filteredLore = uniqueLore    .filter(l => isLoreCategoryMatch(l.category, activeCategory as string))    .filter(l => {      const matchesSearch = l.title.toLowerCase().includes(searchTerm.toLowerCase()) || l.description.toLowerCase().includes(searchTerm.toLowerCase());      if (matchesSearch) return true;      if ((activeCategory === 'Story & Quests' || (activeCategory as string) === 'Events') && l.details?.eventSteps) {        return l.details.eventSteps.some((s: any) =>           (s.title || '').toLowerCase().includes(searchTerm.toLowerCase()) ||           (s.description || '').toLowerCase().includes(searchTerm.toLowerCase())        );      }      return false;    })    .sort((a, b) => (a.order || 0) - (b.order || 0));  const [groupByFaction, setGroupByFaction] = useState<boolean>(true);  const factionGroupedLore = useMemo(() => {    if (activeCategory !== 'Charaktere' && activeCategory !== 'Gegner') return null;    const officialFactionEntries = lore      .filter(l => l.category === 'Fraktionen')      .map(l => l.title.trim())      .filter(Boolean);    const factionMap = new Map<string, LoreEntry[]>();    filteredLore.forEach(entry => {      const rawFaction = entry.details?.faction;      let factionList: string[] = [];      if (rawFaction && typeof rawFaction === 'string' && rawFaction.trim()) {        factionList = rawFaction.split(',').map((f: string) => f.trim()).filter(Boolean);      }      if (factionList.length === 0) {        const key = 'Ungebunden / Ohne Fraktion';        if (!factionMap.has(key)) factionMap.set(key, []);        factionMap.get(key)!.push(entry);      } else {
