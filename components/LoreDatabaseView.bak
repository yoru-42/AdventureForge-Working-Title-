            {(mapZoomLevel === 'micro' || mapZoomLevel === 'building') && (              <div className="col-span-12 lg:col-span-4 bg-slate-900/90 border border-indigo-500/30 rounded-3xl p-5 flex flex-col gap-4 shadow-xl relative overflow-hidden animate-in slide-in-from-right duration-300">                <div className="absolute top-0 w-full h-1 bg-gradient-to-r from-red-500 via-indigo-500 to-cyan-500 left-0">
</div>                <div className="flex items-center justify-between border-b border-slate-800 pb-2.5">                  <div>                    <h4 className="text-sm font-bold text-white flex items-center gap-2 font-sans tracking-tight">                      <i className="fa-solid fa-gamepad text-indigo-400">
</i>                      <span>Combat Simulator 🌌</span>                    </h4>                    <span className="text-[9px] text-cyan-400 font-mono tracking-wider uppercase font-bold">Tactical Blueprint Active</span>                  </div>                  <span className="bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 px-2 py-0.5 rounded text-[8px] font-mono font-bold uppercase animate-pulse">                    LIVE TEST                  </span>                </div>                <p className="text-[11px] text-slate-400 leading-relaxed">                  Beschwöre interaktiv mächtige Elementareffekte direkt auf das Planquadrat-Gitter der Kampfkarte, um die physikalischen Synergien zu simulieren.                </p>                {/* Spell selection */}
