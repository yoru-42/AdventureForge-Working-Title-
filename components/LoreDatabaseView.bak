                          onChange={(e) => setManualY1(Math.max(0, Math.min(100, Number(e.target.value))))}
                          className="bg-slate-950 border border-slate-800 rounded-lg px-2 py-1 text-xs text-slate-200 font-mono"                        />                      </div>                    </div>                  )}
                </div>                {/* Zielpunkt */}
                <div className="bg-slate-900/40 p-3 rounded-2xl border border-slate-800/60 flex flex-col gap-2.5">                  <span className="text-[9px] font-black uppercase text-rose-500/80 tracking-widest flex items-center gap-1">                    <span className="w-1.5 h-1.5 bg-rose-500 rounded-full"></span> Zielpunkt                  </span>                                    <div className="flex gap-2">                    <select                      value={
