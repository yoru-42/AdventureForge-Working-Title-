                    >                      <span className="text-xs">❄️</span>                      <div className="flex flex-col">                        <span className="text-[10px] font-bold">Eis-Zauber</span>                        <span className="text-[8px] text-cyan-500 font-semibold">Kälte / Frost</span>                      </div>                    </button>                    {/* Kettenblitz */}
