                        </svg>                        {/* Background thematic elements: windrose, ship, sea monster */}                        <svg className="absolute inset-0 w-full h-full opacity-50 pointer-events-none" viewBox="0 0 100 100">                          {/* One Piece geography elements rendered under landmasses */}                          {isOnePiece && (                            <g opacity="0.75" className="transition-all duration-500">                              {/* Grand Line goes from (0,100) to (100,0) diagonally */}                              <path                                d="M -10,110 L 110,-10 L 115,-5 L -5,115 Z"                                fill="#dceef5"                                stroke="#5ea8c2"                                strokeWidth="0.25"                                opacity="0.65"                              />
                              {/* Calm Belt Upper */}                              <path                                d="M -15,105 L 105,-15 L 110,-10 L -10,110 Z"                                fill="#f0f7f9"                                stroke="#5ea8c2"                                strokeWidth="0.15"                                strokeDasharray="1,1"                                opacity="0.5"                              />
                              {/* Calm Belt Lower */}                              <path                                d="M -5,115 L 115,-5 L 120,0 L 0,120 Z"                                fill="#f0f7f9"                                stroke="#5ea8c2"                                strokeWidth="0.15"                                strokeDasharray="1,1"                                opacity="0.5"                              />
                                                            {/* Red Line (Diagonal cross-cutting perpendicular ring, from (0,0) to (100,100)) */}                              <path                                d="M -10,-10 L 110,110 L 115,105 L -5,-15 Z"                                fill="#e6a495"                                stroke="#b35a46"                                strokeWidth="0.35"                                opacity="0.8"                              />
