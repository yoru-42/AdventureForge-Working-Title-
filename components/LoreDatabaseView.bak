 setIsEditing(null);
 setEditForm({
 category: 'Orte' });}}
                    className="text-[11px] text-slate-400 hover:text-white bg-slate-850 px-2 py-1 rounded border border-slate-800"                  >                    Zurücksetzen (Neuen Ort erstellen)                  </button>                )}
              </div>              {/* 2-Tab Selector */}
              <div className="flex border-b border-slate-800 gap-2">                <button                   type="button"                  onClick={() => setOrteFormTab('setting')}
                  className={
`px-4 py-2 text-xs font-bold border-b-2 transition-all ${                    orteFormTab === 'setting'                       ? 'border-amber-500 text-amber-500 bg-amber-500/5'                       : 'border-transparent text-slate-400 hover:text-white hover:bg-slate-800/30'                  } rounded-t-lg`}
                >                  <i className="fa-solid fa-sliders mr-1.5"></i> 1. Welteinstellungen / Setting-Erstellung                </button>                <button                   type="button"                  onClick={() => setOrteFormTab('ebenen')}
                  className={
`px-4 py-2 text-xs font-bold border-b-2 transition-all ${                    orteFormTab === 'ebenen'                       ? 'border-amber-500 text-amber-500 bg-amber-500/5'                       : 'border-transparent text-slate-400 hover:text-white hover:bg-slate-800/30'                  } rounded-t-lg`}
                >                  <i className="fa-solid fa-layer-group mr-1.5"></i> 2. Hierarchische Ebenen (Formular &amp;
 Verbindung)                </button>              </div>              {
orteFormTab === 'setting' ? (                
/* TAB 1: WELTEINSTELLUNGEN & PRESETS */
                <div className="flex flex-col gap-5 animate-in fade-in duration-200">                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">                    {/* Geografische Struktur */}
                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-bold uppercase">Geografische Struktur der Welt</label>                      <select                         className="bg-slate-950 border border-slate-800 rounded-xl p-3 text-white text-sm outline-none focus:border-amber-500 h-[46px]"                        value={
editForm.details?.worldSettingType || 'continent'}
                        onChange={
e => updateDetail('worldSettingType', e.target.value)}
                      >                        <option value="continent">Kontinent (Großes geschlossenes Festland)</option>                        <option value="island">Insel (Einzelne große Insel)</option>                        <option value="peninsula">Halbinsel (Dreiseitig von Wasser umgeben)</option>                        <option value="archipelago">Archipel / Inselgruppe (Viele kleine verstreute Inseln)</option>                        <option value="other">Anderes (z.B. Schwebende Kontinente, Unterwasserwelt)</option>                      </select>                    </div>                    {/* Reiseregeln & Erreichbarkeit */}
                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-bold uppercase">Routenplanung &amp;
