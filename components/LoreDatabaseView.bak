                        />                      </div>                    </div>                    {
deleteConfirmId === selectedNode.id ? (                      <div className="flex items-center gap-2 bg-red-950/20 border border-red-900/30 p-1.5 rounded-xl animate-in fade-in duration-150 shrink-0">                        <span className="text-[10px] font-bold text-red-400 px-1">Löschen?</span>                        <button                          type="button"                          onClick={() => {
