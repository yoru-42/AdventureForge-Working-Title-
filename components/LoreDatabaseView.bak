<strong className="text-slate-400">Einwohner:</strong>
{entry.details.population}</span>}                                  {entry.details.maxCapacity && <span className="bg-amber-950/20 border border-amber-800/20 px-2 py-0.5 rounded text-amber-300">
<strong className="text-amber-400/80">Max. Kapazität:</strong>
{entry.details.maxCapacity} Personen</span>}                                  {entry.details.coordinates && <span className="bg-emerald-950/20 border border-emerald-800/20 px-2 py-0.5 rounded text-emerald-300">
<strong className="text-emerald-400/80">Seekarte (X,Y):</strong>
