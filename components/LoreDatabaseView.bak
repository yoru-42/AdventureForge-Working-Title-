                      </div>                    </div>                    <div className="flex flex-col gap-1">                      <label className="text-[10px] font-bold text-slate-400 uppercase">Beschreibung</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded p-2 text-xs text-white outline-none focus:border-amber-500"                        placeholder="Kurze Notiz für die Atmosphäre"                        value={
