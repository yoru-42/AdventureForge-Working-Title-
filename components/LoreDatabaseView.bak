manualX1}
                          onChange={(e) => setManualX1(Math.max(0, Math.min(100, Number(e.target.value))))}
                          className="bg-slate-950 border border-slate-800 rounded-lg px-2 py-1 text-xs text-slate-200 font-mono"                        />
                      </div>                      <div className="flex flex-col gap-1">                        <span className="text-[8px] text-slate-500 font-bold uppercase font-mono">Manuell Y (%):</span>                        <input                          type="number"                          min="0"                          max="100"                          value={
