</i>                      <p className="text-xs font-bold text-slate-400">Keine Orte gefunden</p>                      <p className="text-[10px] text-slate-500 max-w-xs mt-1">                        Passe deine Suchbegriffe oder Filter an oder klicke oben auf "Karte synchronisieren", um die Timeline-Punkte zu generieren.                      </p>                    </div>                  );}
/* Sorting: Macro first, then Meso, then Micro. Inside, alphabetical or by index if story. */
                const sortedPlaces = [...filteredPlaces].sort((a, b) => {
                  const levelWeight: Record<string, number> = { macro: 1, meso: 2, micro: 3, building: 4 };
                  const aLvl = a.details?.mapLevel || 'meso';
                  const bLvl = b.details?.mapLevel || 'meso';
                                    if (levelWeight[aLvl] !== levelWeight[bLvl]) {
                    return levelWeight[aLvl] - levelWeight[bLvl];}
