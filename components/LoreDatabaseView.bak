              <div className="flex flex-col gap-2 bg-slate-900/20 p-3 rounded-2xl border border-slate-800/80">                <span className="text-[9px] font-black uppercase text-slate-400 tracking-wider flex items-center gap-1.5">                  <i className="fa-solid fa-plane-departure text-amber-500 text-[10px]">
</i> Fortbewegungsmittel der Gruppe / des Chats                </span>                                <div className="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-8 gap-2">                  {
TRANSPORTS.map((t) => {
                    const isSelected = selectedTransportId === t.id;
                    return (                      <button                        key={
t.id}
                        type="button"                        onClick={() => setSelectedTransportId(t.id)}
                        className={
`p-1.5 rounded-xl border flex flex-col items-center justify-center text-center transition-all cursor-pointer ${                          isSelected                            ? 'bg-amber-500/20 border-amber-500 text-amber-300 shadow-[0_0_8px_rgba(245,158,11,0.3)]'                            : 'bg-slate-950 border-slate-800 hover:bg-slate-900 text-slate-400 hover:text-slate-200'                        }`}
                        title={
`${t.name}: ${t.description}`}
                      >                        <span className="text-sm leading-none">{
t.icon}
</span>                        <span className="text-[8.5px] font-bold mt-1 leading-none truncate max-w-full">{
t.name}
</span>                        <span className="text-[7.5px] text-slate-500 mt-0.5 leading-none">                          {(mapZoomLevel === 'micro' || mapZoomLevel === 'building') ? `${t.speedMs} m/s` : `${t.speedKmh} km/h`}
                        </span>                      </button>                    );})}
                </div>              </div>              {/* Calculation Result */}
              {(() => {
                const sNode = lore.find(l => l.id === travelStartNodeId && l.category === 'Orte');
                const eNode = lore.find(l => l.id === travelEndNodeId && l.category === 'Orte');
                                const tx1 = sNode ? (sNode.details?.coordinates?.x ?? 50) : manualX1;
                const ty1 = sNode ? (sNode.details?.coordinates?.y ?? 50) : manualY1;
                const tx2 = eNode ? (eNode.details?.coordinates?.x ?? 50) : manualX2;
                const ty2 = eNode ? (eNode.details?.coordinates?.y ?? 50) : manualY2;
                const dx = tx2 - tx1;
                const dy = ty2 - ty1;
                const distanceInTiles = Math.sqrt(dx * dx + dy * dy) / 10;
/* Determine if we are in One Piece World */
                const isOnePieceWorld = !!world?.isOnePiece;
                let scaleFactor = 50;
/* default for macro (km) */
                let unit = 'km';
                let levelName = 'Welt-Kachel';
                if (mapZoomLevel === 'meso') {
                  scaleFactor = 5;
/* region (km) */
                  unit = 'km';                  levelName = 'Regional-Kachel';
                }
 else if (mapZoomLevel === 'micro') {
                  scaleFactor = 50;
/* places (m) */
                  unit = 'm';                  levelName = 'Orte-Kachel';
                }
 else if (mapZoomLevel === 'building') {
                  scaleFactor = 5;
/* building (m) */
                  unit = 'm';                  levelName = 'Gebäude-Kachel';
                }
                                const physicalDistance = distanceInTiles * scaleFactor;
                const activeTransport = TRANSPORTS.find(t => t.id === selectedTransportId) || TRANSPORTS[0];
                                let travelTimeSeconds = 0;
                if (activeTransport.id === 'portal') {
                  travelTimeSeconds = 0;}
 else if (mapZoomLevel === 'micro' || mapZoomLevel === 'building') {/* distance in m, speed in m/s */                travelTimeSeconds = physicalDistance / activeTransport.speedMs; }
 else {
/* distance in km, speed in km/h */
                  const hours = physicalDistance / activeTransport.speedKmh;
                  travelTimeSeconds = hours * 3600;}
/* Nautical units override for One Piece Map macro scale */
                const isNautical = isOnePieceWorld && (mapZoomLevel === 'macro' || mapZoomLevel === 'meso');
                const finalDistance = isNautical ? (physicalDistance / 1.852) : physicalDistance;
                const finalUnit = isNautical ? 'sm (Seemeilen)' : unit;
                const finalSpeedDisplay = isNautical                   ? (activeTransport.id === 'portal' ? 'sofort' : `${Math.round(activeTransport.speedKmh / 1.852)} kn (Knoten)`)                  : ((mapZoomLevel === 'micro' || mapZoomLevel === 'building') ? `${activeTransport.speedMs} m/s` : `${activeTransport.speedKmh} km/h`);
                const formatTravelTime = (seconds: number) => {
                  if (activeTransport.id === 'portal') return 'Sofortig (Portal-Teleportation)';
                  if (seconds < 1) return 'Weniger als 1 Sekunde';
                                    const days = Math.floor(seconds / 86400);
                  const hours = Math.floor((seconds % 86400) / 3600);
                  const minutes = Math.floor((seconds % 3600) / 60);
                  const remainingSeconds = Math.round(seconds % 60);
                                    const parts: string[] = [];
                  if (days > 0) parts.push(`${days} ${days === 1 ? 'Tag' : 'Tage'}`);
                  if (hours > 0) parts.push(`${hours} ${hours === 1 ? 'Stunde' : 'Stunden'}`);
                  if (minutes > 0) parts.push(`${minutes} ${minutes === 1 ? 'Minute' : 'Minuten'}`);
                  if (remainingSeconds > 0 && days === 0 && hours === 0) {
                    parts.push(`${remainingSeconds} ${remainingSeconds === 1 ? 'Sekunde' : 'Sekunden'}`);}
                                    return parts.join(', ');}
;
/* One Piece Routing Warnings */
                let routingWarnings: React.ReactNode[] = [];
                if (isOnePieceWorld && mapZoomLevel === 'macro') {
                  const getZoneName = (x: number, y: number) => {
                    if (x >= 47 && x <= 53) return 'Red Line / Mariejoa / Reverse Mountain';
                    if (y >= 41 && y <= 45) return 'Calm Belt Nord';
                    if (y >= 55 && y <= 59) return 'Calm Belt Süd';
                    if (y >= 45 && y <= 55) {
                      if (x < 47) return 'Neue Welt';
                      if (x > 53) return 'Paradise (Grand Line)';}
                    if (y < 41) {
                      if (x < 47) return 'North Blue';
                      if (x > 53) return 'East Blue';}
                    if (y > 59) {
                      if (x < 47) return 'West Blue';
                      if (x > 53) return 'South Blue';}
                    return 'Unbekannte See';}
;
                  const zoneStart = getZoneName(tx1, ty1);
                  const zoneEnd = getZoneName(tx2, ty2);
/* Calm Belt crossing check */
                  const startsInBlue = ty1 < 41 || ty1 > 59;
                  const endsInBlue = ty2 < 41 || ty2 > 59;
                  const startsInGL = ty1 >= 45 && ty1 <= 55;
                  const endsInGL = ty2 >= 45 && ty2 <= 55;
                  const crossesCalmBelt = (startsInBlue && endsInGL) || (startsInGL && endsInBlue) || zoneStart.includes('Calm Belt') || zoneEnd.includes('Calm Belt');
                  const crossesRedLine = (tx1 < 50 && tx2 > 50) || (tx1 > 50 && tx2 < 50);
                  if (crossesCalmBelt) {
                    const isCalmBeltSafe = ['marine_ship', 'seaking_ship', 'portal', 'luftschiff'].includes(activeTransport.id);
                    if (!isCalmBeltSafe) {
                      routingWarnings.push(                        <div key="calm-belt-warn" className="p-3 bg-red-950/40 border border-red-500/30 rounded-xl flex items-start gap-2 text-red-200 text-[10px] leading-relaxed">                          <span className="text-sm shrink-0">🚨</span>                          <div>                            <strong className="text-red-400 font-bold block mb-0.5">Calm Belt Blockade:</strong>                            Ihr überquert den Calm Belt. Hier herrscht absolute Windstille und es wimmelt von gigantischen Seekönigen! Normale Segelschiffe wie <span className="font-bold underline text-white">{
activeTransport.name}
</span> bleiben hier stecken und werden angegriffen. Verwende ein <strong>Marine-Kriegsschiff (mit Seestein)</strong>, eine <strong>Seekönig-Kutsche</strong> oder Luftwege!                          </div>                        </div>                      );}
 else {
                      routingWarnings.push(                        <div key="calm-belt-ok" className="p-2.5 bg-emerald-950/40 border border-emerald-500/30 rounded-xl flex items-start gap-2 text-emerald-200 text-[10px] leading-relaxed">                          <span className="text-xs shrink-0">✅</span>                          <div>                            <strong className="text-emerald-400 font-bold block">Calm Belt passierbar:</strong>                            Dank <span className="font-bold text-white">{
activeTransport.name}
</span> könnt ihr den windstillen Calm Belt und seine Seeungeheuer sicher überwinden.                          </div>                        </div>                      );}}
                  if (crossesRedLine) {
                    const isRedLineSkip = ['portal', 'luftschiff'].includes(activeTransport.id);
                    if (!isRedLineSkip) {
                      const isParadiseToNewWorld = (startsInGL && endsInGL) || (zoneStart.includes('Paradise') && zoneEnd.includes('Neue Welt')) || (zoneStart.includes('Neue Welt') && zoneEnd.includes('Paradise'));
                      if (isParadiseToNewWorld) {
                        if (activeTransport.id === 'submarine') {
                          routingWarnings.push(                            <div key="red-line-sub" className="p-2.5 bg-sky-950/40 border border-sky-500/30 rounded-xl flex items-start gap-2 text-sky-200 text-[10px] leading-relaxed">                              <span className="text-xs shrink-0">⚓</span>                              <div>                                <strong className="text-sky-400 font-bold block">U-Boot-Passage unter der Red Line:</strong>                                Euer U-Boot ermöglicht es euch, den Tiefsee-Weg über die <strong>Fischmenschen-Insel (10.000 Meter Tiefe)</strong> zu nehmen und die unüberwindbare Red Line zu unterqueren!                              </div>                            </div>                          );}
 else if (activeTransport.id === 'marine_ship') {
                          routingWarnings.push(                            <div key="red-line-marine" className="p-2.5 bg-blue-950/40 border border-blue-500/30 rounded-xl flex items-start gap-2 text-blue-200 text-[10px] leading-relaxed">                              <span className="text-xs shrink-0">🏛️</span>                              <div>                                <strong className="text-blue-400 font-bold block">Passage über das Heilige Land Mariejoa:</strong>                                Als Marine-Kriegsschiff besitzt ihr Regierungsfreigaben. Die Crew kann über die Red Line hinwegreisen (Schiffwechsel in Mariejoa erforderlich).                              </div>                            </div>                          );}
 else {
                          routingWarnings.push(                            <div key="red-line-pirate" className="p-3 bg-amber-950/40 border border-amber-500/30 rounded-xl flex items-start gap-2 text-amber-200 text-[10px] leading-relaxed">                              <span className="text-sm shrink-0">🧼</span>                              <div>                                <strong className="text-amber-400 font-bold block mb-0.5">Schiffscoating & Fischmenschen-Insel benötigt:</strong>                                Ihr überquert die Red Line. Piraten können nicht über Mariejoa reisen! Ihr müsst euer Schiff auf dem <strong>Sabaody Archipel</strong> mit speziellem Seifenblasen-Harz beschichten lassen (Coating), um über die <strong>Fischmenschen-Insel</strong> in der Tiefsee in die Neue Welt einzudringen.                              </div>                            </div>                          );}}
 else {
                        routingWarnings.push(                          <div key="red-line-reverse" className="p-2.5 bg-amber-950/40 border border-amber-500/30 rounded-xl flex items-start gap-2 text-amber-200 text-[10px] leading-relaxed">                            <span className="text-xs shrink-0">🏔️</span>                            <div>                              <strong className="text-amber-400 font-bold block">Reverse Mountain Kanalpassage:</strong>                              Reisen zwischen den Blue Oceans und der Grand Line erfordern die gefährliche Fahrt über die Strömungskanäle des <strong>Reverse Mountain</strong> am Schnittpunkt der Red Line!                            </div>                          </div>                        );}}
                  }}
                return (                  <div className="space-y-3">                    <div className="bg-amber-950/15 border border-amber-500/30 rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4">                      <div className="flex items-start gap-3 min-w-0">                        <div className="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center shrink-0 text-amber-500 text-lg">                          <i className="fa-solid fa-compass-drafting">
</i>                        </div>                        <div className="min-w-0">                          <p className="text-[9px] font-black uppercase text-amber-500 tracking-wider">Ergebnis der Gitternetz-Berechnung</p>                          <div className="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 mt-0.5">                            <span className="text-sm font-bold text-slate-100">Distanz:</span>                            <span className="text-base font-extrabold text-amber-400 font-mono">                              {
finalDistance.toFixed(2)}
 {
finalUnit}
                            </span>                            <span className="text-[10px] text-slate-400 font-mono">                              ({
distanceInTiles.toFixed(2)}
 {
levelName}
{
distanceInTiles === 1 ? '' : 'n'})                            </span>                          </div>                          <p className="text-[10px] text-slate-300 mt-1 leading-relaxed">                            Die Gruppe reist mit <span className="font-bold text-amber-300">{
activeTransport.icon}
 {
activeTransport.name}
</span> (Geschwindigkeit: {
finalSpeedDisplay}).                          </p>                        </div>                      </div>                      <div className="flex flex-col items-center md:items-end shrink-0 self-stretch md:self-auto bg-slate-900/60 md:bg-transparent p-3 md:p-0 rounded-xl border border-slate-800 md:border-0 justify-center">                        <span className="text-[9px] font-black uppercase text-slate-500 tracking-wider">Berechnete Reisedauer</span>                        <span className="text-sm md:text-base font-extrabold text-emerald-400 tracking-tight font-mono text-center md:text-right mt-0.5">                          {
formatTravelTime(travelTimeSeconds)}
                        </span>                      </div>                    </div>                    {/* Routing Warnings / Navigation advisory */}
                    {
routingWarnings.length > 0 && (                      <div className="bg-slate-950/60 border border-slate-850 rounded-2xl p-3.5 space-y-2.5">                        <h5 className="text-[9.5px] font-black uppercase text-amber-500 tracking-widest flex items-center gap-1.5 border-b border-slate-900 pb-1.5">                          <i className="fa-solid fa-shield-halved text-amber-500 text-[10px]">
</i> Navigations-Warnungen & Routen-Hinweise (Kanon-Konform)                        </h5>                        <div className="flex flex-col gap-2">                          {
routingWarnings}
                        </div>                      </div>                    )}
                  </div>                );})()}
            </div>            {/* Universelle visuelle Kachel-Bibliothek Legende */}
            <div className="bg-slate-950/40 p-4 sm:p-5 rounded-3xl border border-slate-800/80 shadow-xl flex flex-col gap-3">              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 border-b border-slate-800 pb-2.5">                <div>                  <h4 className="text-xs font-bold text-amber-500 uppercase tracking-wider flex items-center gap-1.5">                    <i className="fa-solid fa-layer-group text-[11px]">
</i> Universelle Visuelle Kachel-Bibliothek (Legende)                  </h4>                  <p className="text-[10px] text-slate-400 mt-0.5">                    Die 11 vordefinierten Gelände-Elemente für die Weltkarte auf allen Ebenen (Welt, Region, Orte)                  </p>                </div>              </div>                            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 mt-1">                {
TERRAIN_PRESETS.map((preset) => (                  <div                     key={
