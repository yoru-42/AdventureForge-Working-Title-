                        >                          <i className="fa-solid fa-map text-sm"></i>                          <div className="flex flex-col">                            <span className="text-[10px] font-bold">🗺️ Landflächen</span>                            <span className="text-[8px] text-slate-500">{
editForm.details?.worldHasLandflächen ? 'Vorhanden' : 'Keine'}
</span>                          </div>                        </button>                      </div>                    </div>                    {/* Epoche / Ära */}
                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-bold uppercase">Epoche / Zeitära der Geschichte</label>                      <input                         type="text"                         placeholder="z.B. Das Zeitalter der Entdeckungen / Postapokalyptisches Jahr 120"                        className="bg-slate-950 border border-slate-800 rounded-xl p-3 text-white text-sm outline-none focus:border-amber-500 h-[44px]"                        value={
