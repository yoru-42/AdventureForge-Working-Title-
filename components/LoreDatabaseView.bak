                          className="px-2.5 py-1 bg-red-600 hover:bg-red-500 text-white rounded-lg text-[10px] font-bold shadow-md transition-all"                        >                          Ja                        </button>                        <button                          type="button"                          onClick={() => setDeleteConfirmId(null)}
                          className="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[10px] font-bold transition-all border border-slate-700"                        >                          Nein                        </button>                      </div>                    ) : (                      <button                        onClick={() => {
