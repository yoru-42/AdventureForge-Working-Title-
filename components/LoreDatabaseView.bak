²                              </span>                            </div>                            <div className="flex items-center justify-between">                              <span className="text-slate-400 font-semibold">Maßstab-Raster:</span>                              <span className="text-slate-200 font-bold">                                1 {
tileLabel}
 = <span className="text-amber-400 font-mono">{
tileFactor}
 {
unit}
</span>                              </span>                            </div>                            <div className="flex items-center justify-between border-t border-slate-800/50 pt-1.5 mt-1 text-emerald-400 font-bold">                              <span>Kachel-Belegung auf Karte:</span>                              <span className="font-mono">                                {
widthInTiles.toFixed(2)}
 x {
heightInTiles.toFixed(2)}
