                  (() => {
                    const isOnePiece = !!world?.isOnePiece;                    return (                      <div className="absolute inset-0 pointer-events-none select-none overflow-hidden bg-[#f5eeda] border border-[#dcd0b4]">                        {/* Grid of Latitude/Longitude lines */}                        <svg className="absolute inset-0 w-full h-full opacity-35" viewBox="0 0 100 100" preserveAspectRatio="none">                          <defs>                            <pattern id="nautical-grid" width="10" height="10" patternUnits="userSpaceOnUse">                              <path d="M 10 0 L 0 0 0 10" fill="none" stroke="#d4c5a2" strokeWidth="0.1" />
