          id: oceanId,          name: 'Ozean',          type: 'meer',          description: `Zusammenhängendes Meeresgebiet rund um ${mainTerr.name}.`,          parentId: null,          x: parentX,          y: parentY,          radius: Math.round(parentRadius * 2.5),          points: generateOrganicShape('meer', 'wasser', 'Ozean', oceanId),          biome: 'ozean',          terrain: 'wasser',          isUnlocked: true } as Territory;
        generated.push(primaryOcean);
