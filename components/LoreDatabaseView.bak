</i>          )}          <h3 className="text-sm font-bold text-amber-500 truncate">{entry.title}</h3>        </div>        <div className="flex gap-1 shrink-0 bg-slate-950/80 rounded-lg border border-slate-800 p-0.5 items-center">          {deleteConfirmId === entry.id ? (            <div className="flex items-center gap-1 animate-in fade-in duration-150">              <span className="text-[9px] font-bold text-red-400 px-1">Löschen?</span>              <button                type="button"                onClick={(e) =>
{                  e.stopPropagation();                  handleDelete(entry.id);                  setDeleteConfirmId(null);                }}                className="px-1.5 py-0.5 bg-red-600 hover:bg-red-500 text-white rounded text-[9px] font-bold shadow-sm transition-all"              >                Ja              </button>              <button                type="button"                onClick={(e) =>
{                  e.stopPropagation();                  setDeleteConfirmId(null);                }}                className="px-1.5 py-0.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded text-[9px] font-bold border border-slate-700 transition-all"              >                Nein              </button>            </div>          ) : (            <>              <button                 onClick={(e) =>
{ e.stopPropagation(); handleEdit(entry); }}                 className="p-1 w-6 h-6 flex items-center justify-center text-indigo-400 hover:bg-slate-800 hover:text-indigo-300 rounded transition-colors"                 title="Bearbeiten / Details ansehen"              >                <i className="fa-solid fa-pen text-xs">
</i>              </button>              <button                 onClick={(e) =>
{                   e.stopPropagation();                   setDeleteConfirmId(entry.id);                 }}                 className="p-1 w-6 h-6 flex items-center justify-center text-red-400 hover:bg-slate-800 hover:text-red-300 rounded transition-colors"                 title="Löschen"              >                <i className="fa-solid fa-trash text-xs">
</i>              </button>            </>
          )}        </div>      </div>      <div className="flex flex-wrap items-center gap-1.5 min-w-0 mt-auto">        {(activeCategory === 'Charaktere' || activeCategory === 'Gegner') && entry.details?.role && (          <span className="text-[10px] bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full border border-indigo-500/30 truncate max-w-full">{entry.details.role}</span>        )}        {(activeCategory === 'Charaktere' || activeCategory === 'Gegner') && entry.details?.rufName && (          <span className="text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full border border-emerald-500/30 truncate max-w-full font-medium">Rufname: {entry.details.rufName}</span>        )}        {(activeCategory === 'Charaktere' || activeCategory === 'Gegner') && entry.details?.faction && (() =>
{          const officialFactions = lore.filter(l => l.category === 'Fraktionen').map(l => l.title.trim()).filter(Boolean);          const currentList = entry.details.faction.split(',').map((f: string) => f.trim()).filter(Boolean);          let displayList = currentList;          if (officialFactions.length > 0) {            const matched = currentList.filter(f => officialFactions.some(off => off.toLowerCase() === f.toLowerCase()));            if (matched.length > 0) displayList = matched;          }          if (displayList.length === 0) return null;          return (            <span className="text-[10px] bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded-full border border-amber-500/30 truncate max-w-full font-medium flex items-center gap-1">              <i className="fa-solid fa-flag text-[8px] text-amber-400">
</i>              {displayList.join(', ')}            </span>          );        })()}        {activeCategory === 'Fraktionen' && (() =>
{          const count = lore.filter(l =>             (l.category === 'Charaktere' || l.category === 'Gegner') &&             l.details?.faction &&             l.details.faction.split(',').map((f: string) => f.trim().toLowerCase()).includes(entry.title.trim().toLowerCase())          ).length;          return count > 0 ? (            <span className="text-[10px] bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded-full border border-amber-500/30 shrink-0 font-medium">              {count} {count === 1 ? 'Mitglied' : 'Mitglieder'}            </span>          ) : (            <span className="text-[10px] bg-slate-900 text-slate-500 px-2 py-0.5 rounded-full border border-slate-800 shrink-0 font-medium font-mono">              0 Mitglieder            </span>          );        })()}        {activeCategory === 'Gegenstände' && entry.details?.owner && (          <span className="text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full border border-emerald-500/30 truncate max-w-full font-medium flex items-center gap-1">            <i className="fa-solid fa-user text-[9px] text-amber-400">
</i>            Besitzer: {entry.details.owner}          </span>        )}        {activeCategory === 'Orte' && entry.details?.mapLevel && (          <span className={`text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded border truncate shrink-0 ${            entry.details.mapLevel === 'macro'              ? 'bg-indigo-950/80 text-indigo-300 border-indigo-900/40'              : entry.details.mapLevel === 'micro'              ? 'bg-emerald-950/80 text-emerald-300 border-emerald-900/40'              : 'bg-amber-950/80 text-amber-300 border-amber-900/40'          }`}>            {entry.details.mapLevel === 'macro' ? 'Welt' : entry.details.mapLevel === 'micro' ? 'Orte' : 'Region'}          </span>        )}        {activeCategory === 'Orte' && entry.details?.type && (          <span className="text-[10px] bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full border border-indigo-500/30 truncate max-w-full">            Typ: {entry.details.type}          </span>        )}        {activeCategory === 'Orte' && entry.details?.parentPlaceId && (          <span className="text-[10px] bg-slate-900 text-slate-500 px-2 py-0.5 rounded-full border border-slate-850 shrink-0 font-medium font-mono truncate max-w-[140px]" title={`Übergeordnet: ${entry.details.parentPlaceId}`}>            in {entry.details.parentPlaceId}          </span>        )}        {activeCategory === 'Weltregeln' && entry.details?.ruleType && (          <span className="text-[10px] bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded-full border border-amber-500/30 truncate max-w-full font-medium">            {entry.details.ruleType}          </span>        )}        {activeCategory === 'Weltregeln' && entry.details?.scope && (          <span className="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-full border border-slate-700 truncate max-w-full font-medium">            {entry.details.scope}          </span>        )}      </div>    </div>  );  const updateDetail = (key: string, value: any) =>
{    setEditForm(prev => ({      ...prev,      details: {        ...(prev.details || {}),        [key]: value      }    }));  };  const updateAppearanceDetail = (key: string, value: any) =>
{    setEditForm(prev =>
{      const currentDetails = prev.details || {};      let updatedAppearance = { ...currentDetails, [key]: value };      updatedAppearance = autoCalculateAppearance(updatedAppearance, key);      return {        ...prev,        details: updatedAppearance      };    });  };  return (    <div className="w-full flex gap-6 flex-col">      <div ref={formTopRef} className="flex items-center justify-between">        <div>          <h3 className="text-lg font-semibold text-slate-100">Codex (Lore & Wissen)</h3>          <p className="text-xs text-slate-400">Verwalte Charaktere, Orte, Fraktionen und Regeln dieser Welt.</p>        </div>      </div>      <div className="w-full flex flex-wrap gap-2 pb-2 shrink-0">        {visibleCategories.map(c => (          <button            key={c}            onClick={() => setActiveCategory(c)}            className={`text-left px-4 py-2 text-sm rounded-xl transition-all whitespace-nowrap font-medium ${              activeCategory === c               ? 'bg-amber-600 shadow-md shadow-amber-900/20 text-white'              : c === 'Omni-Smart-Fill'                ? 'bg-indigo-950/40 border border-indigo-500/30 text-indigo-300 hover:bg-indigo-900/30'                : 'bg-slate-900 border border-slate-800 text-slate-400 hover:bg-slate-800'            }`}          >            {c === 'Omni-Smart-Fill' && <i className="fa-solid fa-wand-magic-sparkles mr-2 opacity-70 text-amber-400 animate-pulse">
</i>}            {c === 'Charaktere' && <i className="fa-solid fa-users mr-2 opacity-70">
</i>}            {c === 'Verhüllung' && <i className="fa-solid fa-mask mr-2 opacity-70 text-sky-400">
</i>}            {c === 'Gegner' && <i className="fa-solid fa-skull mr-2 opacity-70">
</i>}            {c === 'Orte' && <i className="fa-solid fa-map mr-2 opacity-70">
