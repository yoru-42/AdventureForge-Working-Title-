                      className="py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-bold transition-all cursor-pointer"                    >                      <i className="fa-solid fa-plus mr-1.5 text-amber-500"></i>                      Geländestück platzieren                    </button>                    {/* Show Existing Custom Terrains */}
                    {(world?.terrains || []).length > 0 && (                      <div className="border-t border-slate-800/80 pt-3 flex flex-col gap-1.5 max-h-[140px] overflow-y-auto pr-1">                        <span className="text-[10px] font-bold text-slate-500 uppercase">Platzierte Geländeobjekte:</span>                        {(world.terrains || []).map((t: any, idx: number) => (                          <div key={
