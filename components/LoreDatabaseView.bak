                    >                      <span className="text-xs">☣️</span>                      <div className="flex flex-col">                        <span className="text-[10px] font-bold">Giftgas</span>                        <span className="text-[8px] text-emerald-500 font-semibold">Toxin / Gas</span>                      </div>                    </button>                  </div>                </div>                {/* Coordinate Selector dropdowns */}
                <div className="flex flex-col gap-2">                  <label className="text-[10px] text-slate-400 font-bold uppercase tracking-wider">2. Planquadrat wählen</label>                  <div className="grid grid-cols-2 gap-2">                    {/* Column selector (A-J) */}
                    <div className="flex flex-col gap-1">                      <span className="text-[8px] text-slate-500 uppercase font-mono">Spalte</span>                      <select                        value={
