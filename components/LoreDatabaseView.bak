                      className="flex-1 bg-slate-950 border border-slate-800 rounded-xl p-2 text-xs text-slate-200 outline-none focus:border-amber-500 cursor-pointer"                    >                      <option value="manual">Muster-Koordinate (Manuell)</option>                      {
