                            className="w-full bg-slate-950/80 border border-slate-800 rounded-xl p-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-sky-500/50 resize-none h-24"                          />                        </div>                      );})}
                  </div>                );})()}
            </div>          </div>        ) : (          <div className="flex flex-col gap-4">            <div className="flex flex-wrap items-center justify-between gap-3 bg-slate-900/60 p-3 rounded-2xl border border-slate-800">              <div className="flex items-center gap-2 flex-1 min-w-[200px] bg-slate-950 px-3 py-2 rounded-xl border border-slate-800">                <i className="fa-solid fa-magnifying-glass text-slate-500 text-xs">
</i>                <input                  type="text"                  placeholder="Einträge durchsuchen..."                  value={
