                        className="px-3.5 py-2.5 bg-red-950/50 hover:bg-red-900/60 border border-red-900/50 text-red-400 hover:text-red-300 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shrink-0 self-stretch sm:self-auto justify-center"                        title="Ort löschen"                      >                        <i className="fa-solid fa-trash"></i>                        <span>Löschen</span>                      </button>                    )}
                  </div>                </div>              );})()}
