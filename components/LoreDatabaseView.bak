                        return (                          <div className="bg-slate-950/60 p-3 rounded-xl border border-slate-800/80 mt-1 flex flex-col gap-1 text-[11px] font-sans">                            <div className="flex items-center justify-between">                              <span className="text-slate-400 font-semibold">Tatsächliche Fläche:</span>                              <span className="text-amber-400 font-extrabold font-mono">                                {
