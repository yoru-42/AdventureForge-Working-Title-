                      className="p-4 bg-slate-950 hover:bg-amber-600/10 border border-slate-800 hover:border-amber-500/50 rounded-xl flex flex-col items-center text-center gap-2 transition-all cursor-pointer group"                    >                      <span className="text-2xl group-hover:scale-110 transition-transform">🧝</span>                      <span className="text-xs font-bold text-slate-200">Mittelerde</span>                      <span className="text-[10px] text-slate-400">Auenland, Nebelgebirge, Mordor, Schicksalsberg</span>                    </button>                    <button                      type="button"                      onClick={() => applyPreset('westeros')}
                      className="p-4 bg-slate-950 hover:bg-amber-600/10 border border-slate-800 hover:border-amber-500/50 rounded-xl flex flex-col items-center text-center gap-2 transition-all cursor-pointer group"                    >                      <span className="text-2xl group-hover:scale-110 transition-transform">🐺</span>                      <span className="text-xs font-bold text-slate-200">Westeros</span>                      <span className="text-[10px] text-slate-400">Winterfell, Königsmund, Die Mauer, Tridente</span>                    </button>                  </div>                </div>                {/* 2. AI GENERATION SECTION */}
                <div className="bg-slate-900/80 border border-amber-500/30 p-5 rounded-2xl flex flex-col gap-4 shadow-xl relative overflow-hidden">                  <div className="absolute top-0 w-full h-1 bg-gradient-to-r from-amber-600 to-indigo-600 left-0"></div>                  <h4 className="text-sm font-bold text-amber-500 flex items-center gap-2">                    <i className="fa-solid fa-bolt"></i>                    KI-Weltschöpfung &amp;
 Kartengenerierung                  </h4>                  <p className="text-xs text-slate-300 leading-relaxed">                    Beschreibe deine Wunschwelt detailliert. Die KI generiert daraus ein komplettes System aus Hauptregionen, Bergen, Flüssen, Seen und Handelswegen.                  </p>                  <div className="flex flex-col gap-2.5">                    <textarea                      className="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-white text-xs min-h-[80px] outline-none focus:border-amber-500 resize-y"                      placeholder="z.B. 'Eine düstere Cyberpunk-Insel mit gigantischen Neon-Türmen im Zentrum, einer rauchigen Industriebucht im Osten und einem radioaktiven Ödland im Norden...'"                      value={
