</span>                              ) : isActiveTarget ? (                                <i className="fa-solid fa-location-dot text-[10px] text-white"></i>                              ) : terrainPreset ? (                                <i className={
`${terrainPreset.icon} text-[10px] text-white`}
>
</i>                              ) : node.details?.mapLevel === 'macro' ? (                                <i className="fa-solid fa-globe text-[10px] text-slate-300">
</i>                              ) : node.details?.mapLevel === 'meso' ? (                                <i className="fa-solid fa-mountain-sun text-[10px] text-slate-300">
