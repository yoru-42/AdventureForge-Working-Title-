                        >                          <i className="fa-solid fa-mountain text-sm"></i>                          <div className="flex flex-col">                            <span className="text-[10px] font-bold">⛰️ Berge</span>                            <span className="text-[8px] text-slate-500">{
editForm.details?.worldHasMountains ? 'Vorhanden' : 'Keine'}
</span>                          </div>                        </button>                        {/* Küsten */}
                        <button                          type="button"                          onClick={() => updateDetail('worldHasCoastlines', !editForm.details?.worldHasCoastlines)}
                          className={
