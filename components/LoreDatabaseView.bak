terrainPreset.colorClass}
 border-slate-700/60 hover:border-white hover:scale-110`                                ) : (                                  isSelected                                     ? 'bg-indigo-600 border-white scale-125 ring-4 ring-indigo-500/20'                                     : isActiveTarget                                     ? 'bg-amber-600 border-amber-400 scale-110 ring-4 ring-amber-500/20'                                     : 'bg-slate-900 border-slate-700 hover:border-amber-500 hover:scale-110'                                )                              }`}
                            >                              {
