        const synthId = t.id?.startsWith('terr-') ? t.id : `terr-${t.id}`;
                if (!existingTitles.has(nameLower) && !existingIds.has(t.id) && !existingIds.has(synthId)) {
          existingTitles.add(nameLower);
          existingIds.add(t.id);
          existingIds.add(synthId);
          const typeLabel = t.type === 'welt' ? 'Welt'            : t.type === 'meer' ? 'Ozean / Meer'            : t.type === 'kontinent' ? 'Kontinent'            : t.type === 'insel' ? 'Insel'            : t.type === 'stadt' ? 'Stadt'            : t.type === 'region' ? 'Region'            : t.type === 'gebäude' ? 'Bauwerk'            : 'Weltkarte';
          newLoreEntries.push({
            id: synthId,            category: 'Orte',            title: nameStr,            description: t.description || `Weltkarte-Gebiet (${typeLabel})`,            isUnlocked: true,            details: {
