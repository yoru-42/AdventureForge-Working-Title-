                      setEditForm({
 category: activeCategory as LoreCategory });}}
                    className="px-3 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold border border-slate-700 transition-all flex items-center gap-1.5"                  >                    <i className="fa-solid fa-xmark text-xs"></i>                    <span>Bearbeiten abbrechen</span>                  </button>                )}
              </div>              {/* Smart Fill Box */}
              <div className="bg-slate-950/80 border border-amber-500/30 rounded-xl p-4 flex flex-col gap-3 shadow-inner">                <div className="flex justify-between items-center flex-wrap gap-2">                  <label className="text-xs text-amber-500 font-bold uppercase tracking-wider flex items-center gap-1.5">                    <i className="fa-solid fa-bolt text-amber-400">
</i>                    <span>Smart Fill (KI-Eingabehilfe)</span>                  </label>                  <button                     type="button"                    onClick={
handleLoreSmartFill}
                    disabled={
isSmartFillingLore}
                    className="px-3 py-1.5 bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 disabled:opacity-50 text-white font-bold rounded-lg text-xs transition-all flex items-center gap-2 shadow-md cursor-pointer"                  >                    <i className={
`fa-solid ${isSmartFillingLore ? "fa-spinner animate-spin" : "fa-wand-magic-sparkles"}`}
></i>                    <span>{
isSmartFillingLore ? 'Fülle aus...' : 'Automatisch ausfüllen'}
</span>                  </button>                </div>                <textarea                   className="w-full bg-slate-900 border border-slate-800 rounded-lg p-3 text-slate-200 text-xs min-h-[60px] outline-none focus:border-amber-500 resize-y placeholder-slate-500"                   placeholder={
`Beschreibe den ${activeCategory}-Eintrag in eigenen Worten. Die KI füllt alle Formularfelder automatisch aus.`}
                  value={
loreSmartFill}
                   onChange={(e) => setLoreSmartFill(e.target.value)}
                 />                <div className="flex items-center gap-2 select-none">                  <input                     type="checkbox"                     id="keepExistingLoreDetailsCheckboxMain"                    checked={
keepExistingLoreDetails}
                     onChange={(e) => setKeepExistingLoreDetails(e.target.checked)}
                    className="rounded border-slate-700 bg-slate-900 text-amber-500 focus:ring-0 cursor-pointer w-4 h-4 accent-amber-500"                  />
                  <label htmlFor="keepExistingLoreDetailsCheckboxMain" className="text-[11px] text-slate-300 font-medium cursor-pointer">                    <span className="text-emerald-400 font-bold">Ergänzungs-Modus:</span> Bestehende Formularfelder behalten und neue Daten hinzufügen                  </label>                </div>              </div>              {/* Formular Fields Grid */}
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">                {/* Titel / Name */}
                <div className="flex flex-col gap-1.5">                  <label className="text-xs text-slate-300 font-bold flex items-center gap-1">                    <span>Titel / Name *</span>                  </label>                  <input                    type="text"                    className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                    value={
editForm.title || ''}
                    onChange={(e) => setEditForm(prev => ({...prev, title: e.target.value }))}
                    placeholder="z.B. Lord Vane, Drachenhort..."                  />                </div>                {/* Kategorie */}
                <div className="flex flex-col gap-1.5">                  <label className="text-xs text-slate-300 font-bold">Kategorie</label>                  <select                    className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none cursor-pointer"                    value={
editForm.category || activeCategory}
                    onChange={(e) => setEditForm(prev => ({...prev, category: e.target.value as LoreCategory }))}
                  >                    {
CATEGORIES.map((cat) => (                      <option key={
cat}
 value={
cat}
>{
cat}
</option>                    ))}
                  </select>                </div>                {/* Visible/Unlocked Checkbox */}
                <div className="flex items-center gap-2 col-span-1 md:col-span-2 bg-slate-950/60 p-2.5 rounded-xl border border-slate-800/80">                  <input                    type="checkbox"                    id="isUnlockedFormMainCheckbox"                    checked={
editForm.isUnlocked !== false}
                    onChange={(e) => setEditForm(prev => ({...prev, isUnlocked: e.target.checked }))}
                    className="rounded border-slate-700 bg-slate-900 text-amber-500 focus:ring-0 cursor-pointer w-4 h-4 accent-amber-500"                  />                  <label htmlFor="isUnlockedFormMainCheckbox" className="text-xs text-slate-300 font-semibold cursor-pointer">                    Im Codex für Spieler sichtbar (Freigeschaltet)                  </label>                </div>                {/* Beschreibung / Bio */}
                <div className="flex flex-col gap-1.5 col-span-1 md:col-span-2">                  <label className="text-xs text-slate-300 font-bold">Beschreibung / Hintergrund *</label>                  <textarea                    className="bg-slate-950 border border-slate-800 rounded-xl p-3 text-slate-100 text-xs min-h-[90px] focus:border-amber-500 outline-none resize-y placeholder-slate-600"                    value={
editForm.description || ''}
                    onChange={(e) => setEditForm(prev => ({...prev, description: e.target.value }))}
                    placeholder="Detaillierte Hintergrundgeschichte, Beschreibung und Wichtiges..."                  />                </div>                {/* Category-Specific Fields */}
                {(activeCategory === 'Charaktere' || activeCategory === 'Gegner') && (                  <>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Rolle / Beruf</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.role || ''}
                        onChange={(e) => updateDetail('role', e.target.value)}
                        placeholder="z.B. Söldnerführer, Obermagier..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Rufname / Spitzname</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.rufName || ''}
                        onChange={(e) => updateDetail('rufName', e.target.value)}
                        placeholder="z.B. Kael, Der Schatten..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Fraktion</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.faction || ''}
                        onChange={(e) => updateDetail('faction', e.target.value)}
                        placeholder="z.B. Schattenbund, Gilde..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Rasse / Spezies</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.race || ''}
                        onChange={(e) => updateDetail('race', e.target.value)}
                        placeholder="z.B. Mensch, Elf, Zwerg..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Geschlecht</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.gender || ''}
                        onChange={(e) => updateDetail('gender', e.target.value)}
                        placeholder="z.B. Männlich, Weiblich..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Gesinnung / Ziel</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.goal || ''}
                        onChange={(e) => updateDetail('goal', e.target.value)}
                        placeholder="z.B. Macht streben, Heimat beschützen..."                      />                    </div>                  </>                )}
                {
activeCategory === 'Fraktionen' && (                  <>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Hauptquartier</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.headquarters || ''}
                        onChange={(e) => updateDetail('headquarters', e.target.value)}
                        placeholder="z.B. Zitadelle der Wächter..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Anführer</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.leader || ''}
                        onChange={(e) => updateDetail('leader', e.target.value)}
                        placeholder="z.B. Erzmagier Valerius..."                      />
                    </div>                    <div className="flex flex-col gap-1.5 col-span-1 md:col-span-2">                      <label className="text-xs text-slate-400 font-semibold">Credo / Philosophie</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.philosophy || ''}
                        onChange={(e) => updateDetail('philosophy', e.target.value)}
                        placeholder="z.B. Wissen ist die höchste Macht..."                      />                    </div>                  </>                )}
                {
activeCategory === 'Gegenstände' && (                  <>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Besitzer</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.owner || ''}
                        onChange={(e) => updateDetail('owner', e.target.value)}
                        placeholder="z.B. Spieler, Kaelen..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Typ</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.itemType || ''}
                        onChange={(e) => updateDetail('itemType', e.target.value)}
                        placeholder="z.B. Schwert, Artefakt, Trank..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Seltenheit</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.rarity || ''}
                        onChange={(e) => updateDetail('rarity', e.target.value)}
                        placeholder="z.B. Gewöhnlich, Selten, Legendär..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Effekte / Magie</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.effects || ''}
                        onChange={(e) => updateDetail('effects', e.target.value)}
                        placeholder="z.B. +5 Feuer-Schaden, Unsichtbarkeit..."                      />                    </div>                  </>                )}
                {
activeCategory === 'Weltregeln' && (                  <>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Regeltyp</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.ruleType || ''}
                        onChange={(e) => updateDetail('ruleType', e.target.value)}
                        placeholder="z.B. Magiegesetz, Naturgesetz, Kultur..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Geltungsbereich</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.scope || ''}
                        onChange={(e) => updateDetail('scope', e.target.value)}
                        placeholder="z.B. Weltweit, Nur im Kaiserreich..."                      />                    </div>                  </>                )}
                {
activeCategory === 'Verbotenes Wissen' && (                  <>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Grund für Verbot</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.forbiddenReason || ''}
                        onChange={(e) => updateDetail('forbiddenReason', e.target.value)}
                        placeholder="z.B. Führt zum Wahnsinn, Ältere Macht..."                      />
                    </div>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Gefahren / Auslöser</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.dangerTrigger || ''}
                        onChange={(e) => updateDetail('dangerTrigger', e.target.value)}
                        placeholder="z.B. Berühren des Relikts..."                      />                    </div>                  </>                )}
                {(activeCategory === 'Story & Quests' || (activeCategory as string) === 'Events') && (                  <>                    <div className="flex flex-col gap-1.5">                      <label className="text-xs text-slate-400 font-semibold">Auftraggeber / Beteiligte</label>                      <input                        type="text"                        className="bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-slate-100 text-xs focus:border-amber-500 outline-none"                        value={
editForm.details?.questGiver || ''}
