            <div className="flex flex-col gap-5 bg-slate-900/90 border border-slate-800 p-5 rounded-2xl shadow-xl relative overflow-hidden my-2">              <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-amber-600 via-indigo-600 to-purple-600"></div>              {/* Header */}
              <div className="flex items-center justify-between border-b border-slate-800 pb-3">                <div className="flex items-center gap-2">                  <i className="fa-solid fa-pen-to-square text-amber-500 text-sm"></i>                  <h4 className="text-sm font-bold text-slate-100">                    {
