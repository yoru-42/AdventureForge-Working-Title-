                              setSelectedMesoId(null);}
 else if (lvl === 'meso') {
                              setSelectedMacroId(place.details?.parentPlaceId || null);
                              setSelectedMesoId(null);}
 else if (lvl === 'micro') {
                              const parentMesoId = place.details?.parentPlaceId;
