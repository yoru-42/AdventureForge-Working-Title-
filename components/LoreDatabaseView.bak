</span>                    <i className="fa-solid fa-map-location-dot text-amber-500 text-lg animate-pulse">
</i>                  </div>                  <div className="text-center">                    <h5 className="text-sm font-bold text-slate-100 font-sans tracking-tight">Karten-Generierung läuft...</h5>                    <p className="text-[10px] text-slate-400 max-w-[240px] mt-1 leading-relaxed">                      Die KI analysiert die Storybook-Events und zeichnet die Standorte & Pfade auf die Weltkarte.                    </p>                  </div>                </div>              )}
            </div>            {/* Close map col-span-12 wrapper */}
