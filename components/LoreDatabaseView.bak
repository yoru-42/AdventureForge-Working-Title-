                              )}                              {entry.category === 'Fraktionen' && (                                <>                                  {entry.details.leader && <span className="bg-slate-900 border border-slate-800 px-2 py-0.5 rounded text-slate-300">
<strong className="text-slate-400">Anführer:</strong>
{entry.details.leader}</span>}                                  {entry.details.philosophy && <span className="bg-slate-900 border border-slate-800 px-2 py-0.5 rounded text-slate-300">
<strong className="text-slate-400">Credo:</strong>
{entry.details.philosophy}</span>}                                  {entry.details.maxMembers && <span className="bg-amber-950/20 border border-amber-800/20 px-2 py-0.5 rounded text-amber-300">
