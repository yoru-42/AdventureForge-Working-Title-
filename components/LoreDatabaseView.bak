                          </g>                          {/* Mythical Sea Serpent curve bottom left */}                          <g transform="translate(22, 75) scale(0.3)" opacity="0.65">                            {/* Serpent body coils popping out of ocean */}                            <path d="M0,10 Q5,0 10,10 T20,10 T30,10 T40,10" fill="none" stroke="#719ba2" strokeWidth="1.2" strokeLinecap="round" strokeDasharray="1,2" />
                            <path d="M-2,13 Q2,7 6,13" fill="none" stroke="#719ba2" strokeWidth="0.8" />
                            {/* Serpent head */}                            <path d="M42,7 Q45,2 47,5 L44,9 Z" fill="#719ba2" />
                          </g>                        </svg>                        {/* Vector Landmass Polygons */}                        <svg className="absolute inset-0 w-full h-full" viewBox="0 0 100 100">                          {(() =>
{                            const macroNodes = lore.filter(l => l.category === 'Orte' && l.details?.mapLevel === 'macro');                                                        
/* Dynamic deterministic path generator helper */
                            const getLandmassPath = (cx: number, cy: number, seedStr: string, size = 10) =>
{                              let seed = 0;                              for (let i = 0; i < seedStr.length; i++) {                                seed = seed + seedStr.charCodeAt(i) * (i + 1);                              }                                                            const numPoints = 14;                              const points: {x: number, y: number}[] = [];                              for (let i = 0; i < numPoints; i++) {                                const angle = (i / numPoints) * Math.PI * 2;                                const sinOffset1 = Math.sin(angle * 3 + seed) * 3.5;                                const cosOffset2 = Math.cos(angle * 5 + seed * 1.7) * 2.5;                                const r = size + sinOffset1 + cosOffset2;                                const x = cx + Math.cos(angle) * r;                                const y = cy + Math.sin(angle) * r;                                points.push({ x, y });                              }                                                            
/* Smooth curve path */
                              let d = `M ${points[0].x} ${points[0].y}`;                              for (let i = 0; i < points.length; i++) {                                const nextIdx = (i + 1) % points.length;                                const p1 = points[i];                                const p2 = points[nextIdx];                                const xc = (p1.x + p2.x) / 2;                                const yc = (p1.y + p2.y) / 2;                                d += ` Q ${p1.x} ${p1.y}, ${xc} ${yc}`;                              }                              d += " Z";                              return d;                            };                            
/* If no macro nodes exist, generate default fantasy continents */
                            const nodesToDraw = macroNodes.length > 0 ? macroNodes : [                              {                                id: 'default-continent-1',                                title: 'Nordheim',                                details: {                                  coordinates: { x: 30, y: 35 },                                  climate: 'Kalt, rauh',                                  biome: 'Gletscher, Tundra'                                }                              },                              {                                id: 'default-continent-2',                                title: 'Aethelgard',                                details: {                                  coordinates: { x: 70, y: 55 },                                  climate: 'Warm, fruchtbar',                                  biome: 'Mischwald, Grasland'                                }                              }                            ];                            return nodesToDraw.map((node: any) =>
{                              const coords = node.details?.coordinates || { x: 50, y: 50 };                              const titleLower = (node.title || '').toLowerCase();                              const descLower = (node.description || node.details?.climate || '').toLowerCase();                              const combinedText = `${titleLower} ${descLower}`;                              
/* Determine aesthetic gradients based on Climate/Biome of the Vector Area */
                              let fillGradientId = `grad-land-default-${node.id}`;                              let strokeColor = '#5c4327'; 
/* Rich sepia dark brown */
                              let fillColorFrom = '#dfd3ba'; 
/* Sand cream */
                              let fillColorTo = '#fcf8f2';   
/* Warm ivory */
                              if (combinedText.includes('wüste') || combinedText.includes('desert') || combinedText.includes('sand') || combinedText.includes('hitze') || combinedText.includes('heiß') || combinedText.includes('vulkan') || combinedText.includes('lava')) {
                                fillColorFrom = '#e4af78'; /* terracotta sand */
                                fillColorTo = '#df8c42';   /* dry ochre */
                                strokeColor = '#502f12'; 
                              } else if (combinedText.includes('eis') || combinedText.includes('schnee') || combinedText.includes('frost') || combinedText.includes('kalt') || combinedText.includes('arctic') || combinedText.includes('tundra')) {
                                fillColorFrom = '#d4e5e7'; /* icy slate */
                                fillColorTo = '#fcf8f2';   /* clean frosty white */
                                strokeColor = '#334c54'; 
                              } else if (combinedText.includes('wald') || combinedText.includes('grün') || combinedText.includes('natur') || combinedText.includes('abenteuer') || combinedText.includes('insel') || combinedText.includes('forest') || combinedText.includes('jungle')) { 
                                fillColorFrom = '#abc090';  // light sage green
                                fillColorTo = '#bdcca6';   // soft pastel meadow
                                strokeColor = '#3e4e2a'; 
                              }
/* Auxiliary micro islands around this continent to give organic depth */
                              const auxIslands = [                                { dx: -10, dy: -6, sz: 2.2, seed: node.id + '_is1' },                                { dx: 11, dy: 8, sz: 3.1, seed: node.id + '_is2' },                                { dx: -4, dy: 10, sz: 1.8, seed: node.id + '_is3' }                              ];                              return (                                <g key={`vector-area-group-${node.id}`} className="transition-all duration-700">                                  <defs>                                    <linearGradient id={fillGradientId} x1="0%" y1="0%" x2="100%" y2="100%">                                      <stop offset="0%" stopColor={fillColorFrom} />
                                      <stop offset="100%" stopColor={fillColorTo} />
                                    </linearGradient>                                  </defs>                                  {/* Draw multiple Seekarte coastal contour lines to show depth */}                                  <path                                    d={getLandmassPath(coords.x, coords.y, node.id, 12)}                                    fill="none"                                    stroke="#abcac0"                                    strokeWidth="0.2"                                    opacity="0.45"                                  />
                                  <path                                    d={getLandmassPath(coords.x, coords.y, node.id, 11)}                                    fill="none"                                    stroke="#abcac0"                                    strokeWidth="0.25"                                    opacity="0.65"                                  />
                                  {/* Territorial Border / frontier line of the world */}                                  <path                                    d={getLandmassPath(coords.x, coords.y, node.id, 14)}                                    fill="none"                                    stroke="#b85c5c"                                    strokeWidth="0.35"                                    strokeDasharray="1.5,2.5"                                    opacity="0.8"                                  />
                                  {/* Draw Main Landmass Polygon Surface */}                                  <path                                    d={getLandmassPath(coords.x, coords.y, node.id, 9.5)}                                    fill={`url(#${fillGradientId})`}                                    stroke={strokeColor}                                    strokeWidth="0.5"                                    className="hover:opacity-95 cursor-pointer transition-all duration-300 drop-shadow-md"                                  />
                                  {/* Draw auxiliary surrounding tiny vector islands */}                                  {auxIslands.map((isl, idx) => (                                    <g key={`aux-${node.id}-${idx}`}>                                      <path                                        d={getLandmassPath(coords.x + isl.dx, coords.y + isl.dy, isl.seed, isl.sz)}                                        fill={`url(#${fillGradientId})`}                                        stroke={strokeColor}                                        strokeWidth="0.3"                                        opacity="0.9"                                      />
                                      {/* Subtle coastal reef outer line for tiny island */}                                      <path                                        d={getLandmassPath(coords.x + isl.dx, coords.y + isl.dy, isl.seed, isl.sz + 1.2)}                                        fill="none"                                        stroke="#abcac0"                                        strokeWidth="0.15"                                        opacity="0.5"                                      />
                                    </g>                                  ))}                                  {/* Add terrain element visual decorations on the Vector Continent! */}                                  {/* Mountains: Double Peaks inside the continent */}                                  <g transform={`translate(${coords.x - 4}, ${coords.y - 3}) scale(0.45)`} stroke="#5c4327" strokeWidth="0.65" fill="#cbb796" opacity="0.9">                                    <polygon points="0,5 3,0 6,5" />
                                    <polygon points="3,5 6,1 9,5" fill="#baa380" />
                                  </g>                                  <g transform={`translate(${coords.x + 1}, ${coords.y - 5}) scale(0.35)`} stroke="#5c4327" strokeWidth="0.65" fill="#baa380" opacity="0.8">                                    <polygon points="0,5 3,0 6,5" />
                                  </g>                                  {/* Forests: Pine trees / deciduous cluster */}                                  <g transform={`translate(${coords.x + 3}, ${coords.y + 1}) scale(0.4)`} stroke="#3e4e2a" strokeWidth="0.5" fill="#8ea66f" opacity="0.9">                                    <polygon points="2,4 4,0 6,4" />
                                    <polygon points="0,6 2,2 4,6" />
                                    <polygon points="4,6 6,2 8,6" />
                                  </g>                                  {/* Rivers: A winding blue stream path running from center to coast */}                                  <path                                    d={`M ${coords.x - 1} ${coords.y - 1} Q ${coords.x - 4} ${coords.y + 2}, ${coords.x - 8} ${coords.y + 4}`}                                    fill="none"                                    stroke="#528a9b"                                    strokeWidth="0.45"                                    opacity="0.85"                                    strokeLinecap="round"                                  />
                                  <path                                    d={`M ${coords.x + 2} ${coords.y - 2} Q ${coords.x + 5} ${coords.y}, ${coords.x + 7} ${coords.y + 2}`}                                    fill="none"                                    stroke="#528a9b"                                    strokeWidth="0.35"                                    opacity="0.75"                                    strokeLinecap="round"                                  />
                                </g>                              );                            });                          })()}                          {/* Render custom user-created or AI-created terrains on the map! */}                          {(world?.terrains || []).map((t: any, idx: number) =>
{                            if (t.type === 'Gebirge') {                              return (                                <g transform={`translate(${t.x - 3}, ${t.y - 3.5}) scale(0.6)`} key={`custom-terrain-${idx}`} opacity="0.95">                                  <polygon points="0,10 5,0 10,10" fill="#caa57a" stroke="#5c4327" strokeWidth="0.55" />
