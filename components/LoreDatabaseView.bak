`group/item text-left p-4 rounded-2xl border transition-all cursor-pointer relative overflow-hidden flex flex-col justify-between ${                            isSelected                              ? 'bg-indigo-950/40 border-indigo-500 shadow-lg shadow-indigo-950/50'                              : isActiveTarget                              ? 'bg-amber-950/20 border-amber-500/80 shadow-md shadow-amber-950/30'                              : 'bg-slate-900/60 border-slate-850 hover:border-slate-700 hover:bg-slate-900'                          }`}
                        >                          {
isActiveTarget && (                            <div className="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-amber-500 to-amber-300"></div>                          )}
                          {
isSelected && (                            <div className="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-indigo-500 to-cyan-400"></div>                          )}
                          <div className="flex flex-col gap-2.5">                            <div className="flex items-center justify-between gap-2">                              <span className={
`text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full ${                                lvl === 'macro'                                  ? 'bg-indigo-950/80 text-indigo-300 border border-indigo-900/40'                                  : lvl === 'micro'                                  ? 'bg-emerald-950/80 text-emerald-300 border border-emerald-900/40'                                  : 'bg-amber-950/80 text-amber-300 border border-amber-900/40'                              }`}
>                                {
lvl === 'macro' ? 'Macro' : lvl === 'micro' ? 'Micro' : 'Meso'}
                              </span>                              <div className="flex items-center gap-1.5">                                {
isStory ? (                                  <span className="text-[8px] font-extrabold uppercase tracking-wide bg-amber-600/10 text-amber-400 border border-amber-500/20 px-1.5 py-0.5 rounded" title="Direkt an einen Haupt-Timeline-Schritt gebunden">                                    Story-Hauptort                                  </span>                                ) : (                                  <span className="text-[8px] font-extrabold uppercase tracking-wide bg-indigo-50/10 text-indigo-400 border border-indigo-900/20 px-1.5 py-0.5 rounded" title="Atmosphärischer Zwischenstopp/Reisewegpunkt auf der Weltkarte">                                    Zwischenstation                                  </span>                                )}
                                {
isActiveTarget && (                                  <span className="text-[10px]" title="Aktives Reiseziel">📍</span>                                )}
                              </div>                            </div>                            <div>                              <h4 className={
`text-xs font-bold font-sans tracking-tight transition-colors ${                                isSelected ? 'text-indigo-300' : 'text-slate-100 group-hover/item:text-amber-400'                              }`}
>                                {
place.title}
                              </h4>                              {
place.details?.type && (                                <span className="text-[10px] text-slate-500 font-medium block mt-0.5">                                  Typ: {
place.details.type}
 {
place.details.climate ? `| ${place.details.climate}` : ''}
                                </span>                              )}
                            </div>                            <p className="text-[11px] text-slate-400 line-clamp-2 leading-relaxed italic">                              "{place.description}"                            </p>                          </div>                          <div className="mt-3 pt-2.5 border-t border-slate-800/60 flex items-center justify-between text-[10px] text-slate-500 font-bold">                            <span className="flex items-center gap-1 group-hover/item:text-slate-300 transition-colors">                              <i className="fa-solid fa-location-arrow text-amber-500">
</i>                              <span>Auf Karte zeigen</span>                            </span>                            {
place.details?.parentPlaceId && (                              <span className="text-[9px] text-slate-600 font-normal truncate max-w-[120px]" title={
`Übergeordnet: ${place.details.parentPlaceId}`}
>                                in {
place.details.parentPlaceId}
                              </span>                            )}
                          </div>                        </div>                      );})}
                  </div>                );})()}
            </div>            )}
            {/* 3. Dropdown selection and 4. Form inputs */}
            <div className="bg-slate-900/80 border border-amber-500/30 p-4 sm:p-6 rounded-2xl flex flex-col gap-6 shadow-xl relative overflow-hidden">              <div className="absolute top-0 w-full h-1 bg-gradient-to-r from-amber-600 to-indigo-600 left-0">
</div>                            <div className="flex flex-col sm:flex-row justify-between sm:items-center border-b border-slate-800 pb-3 gap-2">                <h2 className="text-base font-bold text-white flex items-center gap-2">                  <i className={
