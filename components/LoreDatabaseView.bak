                              )}                              {entry.category === 'Gegenstände' && (                                <>                                  {entry.details.itemType && <span className="bg-slate-900 border border-slate-800 px-2 py-0.5 rounded text-slate-300">
<strong className="text-slate-400">Typ:</strong>
