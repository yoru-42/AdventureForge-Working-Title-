`tree-node-item-${node.id}`}
>                        <div                           style={
{
 paddingLeft: `${indent * 12 + 8}px` }}
                          className={
`group/tree-item py-2 pr-4 flex items-center justify-between border-b border-slate-900/40 transition-all cursor-pointer ${                            isSelected                               ? 'bg-indigo-950/20 border-l-2 border-l-indigo-500 text-white shadow-inner'                               : 'hover:bg-slate-900/60 text-slate-350 hover:text-white'                          }`}
                          onClick={() => {
                            setMapZoomLevel(lvl);
                            setSelectedNodeId(node.id);
                                                        if (lvl === 'macro') {
                              setSelectedMacroId(null);
                              setSelectedMesoId(null);}
 else if (lvl === 'meso') {
                              setSelectedMacroId(node.details?.parentPlaceId || null);
                              setSelectedMesoId(null);}
 else if (lvl === 'micro') {
                              const parentMesoId = node.details?.parentPlaceId;
                              setSelectedMesoId(parentMesoId || null);
                              if (parentMesoId) {
                                const parentMeso = lore.find(l => l.category === 'Orte' && l.title === parentMesoId);
                                setSelectedMacroId(parentMeso?.details?.parentPlaceId || null);}
 else {
                                setSelectedMacroId(null);}}
                          }}
                        >                          <div className="flex items-center gap-2.5 truncate">                            {/* Expand/Collapse Chevron if children exist */}
                            {
childrenCount > 0 ? (                              <button                                type="button"                                onClick={(e) => {
                                  e.stopPropagation();
                                  setExpandedNodes(prev => ({...prev, [node.id]: !prev[node.id] }));}}
                                className="w-5 h-5 rounded hover:bg-slate-800 text-slate-500 hover:text-slate-200 flex items-center justify-center transition-colors cursor-pointer"                              >                                <i className={
`fa-solid fa-chevron-right text-[8.5px] transition-transform duration-200 ${isExpanded ? 'rotate-90' : ''}`}
></i>                              </button>                            ) : (                              <div className="w-5 h-5 flex items-center justify-center">                                <span className="w-1 h-1 rounded-full bg-slate-700"></span>                              </div>                            )}
                            {/* Node Icon */}
                            <span className={
`${levelColor} text-xs flex-shrink-0 w-4 text-center`}
>                              <i className={
`fa-solid ${node.details?.icon || levelIcon}`}
></i>                            </span>                            {/* Node Title */}
                            <span className={
`text-xs font-semibold truncate ${isSelected ? 'text-indigo-300' : 'text-slate-100 group-hover/tree-item:text-amber-400'}`}
>                              {
node.title}
                            </span>                            {/* Tag Badge */}
                            {
node.details?.type && (                              <span className="text-[8.5px] font-medium text-slate-500 bg-slate-900 border border-slate-850 px-1.5 py-0.5 rounded truncate max-w-[80px]">                                {
node.details.type}
                              </span>                            )}
                          </div>                          <div className="flex items-center gap-2 shrink-0 opacity-0 group-hover/tree-item:opacity-100 transition-opacity">                            <span className="text-[9.5px] text-slate-500 font-mono flex items-center gap-1">                              <i className="fa-solid fa-location-arrow text-[8px] text-amber-500">
</i>                              <span>Auf Karte</span>                            </span>                          </div>                        </div>                        {/* Collapsible Children rendering */}
                        {
childrenCount > 0 && isExpanded && renderChildren && (                          <div className="relative flex flex-col">                            {/* Vertical indent guide line */}
                            <div                               style={
{
 left: `${indent * 12 + 18}px` }}
                              className="absolute top-0 bottom-1 w-[1px] bg-slate-800/60 pointer-events-none"                            />                            {
renderChildren()}
                          </div>                        )}
                      </div>                    );}
;
                  return (                    <div className="flex flex-col bg-slate-950/45 border border-slate-850 rounded-2xl max-h-[380px] overflow-y-auto divide-y divide-slate-900/60 hide-scrollbar select-none" id="orte-hierarchical-tree-container">                      {
worlds.length === 0 && regions.length === 0 && places.length === 0 ? (                        <div className="text-center p-8 text-slate-500 text-xs">                          Keine hierarchischen Orte vorhanden. Erstelle einen Ort mit Level "Macro" (Welt), um den Baum zu starten!                        </div>                      ) : (                        worlds.map(w => {
                          const childRegions = regions.filter(r => isChildOf(r, w));
                          return renderTreeNode(w, 'fa-globe', 'text-indigo-400', childRegions.length, 0, () => {
                            return childRegions.map(r => {
                              const childPlaces = places.filter(p => isChildOf(p, r));
                              return renderTreeNode(r, 'fa-map', 'text-amber-400', childPlaces.length, 1, () => {
                                return childPlaces.map(p => {
                                  const childBuildings = buildings.filter(b => isChildOf(b, p));
                                  return renderTreeNode(p, 'fa-location-dot', 'text-emerald-400', childBuildings.length, 2, () => {
                                    return childBuildings.map(b => {
                                      return renderTreeNode(b, 'fa-house-chimney', 'text-sky-400', 0, 3);});});});});});});})                      )}
                      {/* Floating / Unassigned Regions / Locations display */}
                      {(() => {
                        const floatingRegions = regions.filter(r => !worlds.some(w => isChildOf(r, w)));
                        const floatingPlaces = places.filter(p => !regions.some(r => isChildOf(p, r)));
                        const floatingBuildings = buildings.filter(b => !places.some(p => isChildOf(b, p)));
                        if (floatingRegions.length > 0 || floatingPlaces.length > 0 || floatingBuildings.length > 0) {
                          return (                            <div className="flex flex-col border-t border-slate-800/80 mt-1">                              <div className="bg-slate-900/30 px-3 py-1.5 text-[9px] font-extrabold uppercase tracking-widest text-slate-500 flex items-center gap-1">                                <i className="fa-solid fa-circle-nodes text-[8px] text-amber-500">
</i>                                <span>Unzugeordnete Ebenen (Reisewege / Einzellandschaften)</span>                              </div>                                                            {
floatingRegions.map(r => {
                                const childPlaces = places.filter(p => isChildOf(p, r));
                                return renderTreeNode(r, 'fa-map', 'text-amber-500/80', childPlaces.length, 0, () => {
                                  return childPlaces.map(p => {
                                    const childBuildings = buildings.filter(b => isChildOf(b, p));
                                    return renderTreeNode(p, 'fa-location-dot', 'text-emerald-500/80', childBuildings.length, 1, () => {
                                      return childBuildings.map(b => {
                                        return renderTreeNode(b, 'fa-house-chimney', 'text-sky-500/80', 0, 2);});});});});})}
                              {
floatingPlaces.map(p => {
                                const childBuildings = buildings.filter(b => isChildOf(b, p));
                                return renderTreeNode(p, 'fa-location-dot', 'text-emerald-500/80', childBuildings.length, 0, () => {
                                  return childBuildings.map(b => {
                                    return renderTreeNode(b, 'fa-house-chimney', 'text-sky-500/80', 0, 1);});});})}
                              {
floatingBuildings.map(b => {
                                return renderTreeNode(b, 'fa-house-chimney', 'text-sky-500/80', 0, 0);})}
                            </div>                          );}
                        return null;})()}
                    </div>                  );}
                return (                  <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 max-h-[380px] overflow-y-auto pr-1 select-none hide-scrollbar">                    {
sortedPlaces.map(place => {
                      const isSelected = selectedNodeId === place.id;
                      const isStory = !!place.details?.associatedEventStepId;
