      objectsToScan.forEach((obj: any) => {
        if (!obj) return;
        const objNameStr = (obj.name || obj.title || '').trim();
        if (!objNameStr) return;
        const objNameLower = objNameStr.toLowerCase();
        if (!existingTitles.has(objNameLower) && (!obj.loreEntryId || !existingIds.has(obj.loreEntryId))) {
          existingTitles.add(objNameLower);
          let targetCategory: LoreCategory = 'Orte';
          if (obj.category === 'Gegner & Fraktionen') targetCategory = 'Gegner';
          else if (obj.category === 'Schiffe & Fahrzeuge' || obj.category === 'Ausrüstung' || obj.category === 'Schätze & Loot') targetCategory = 'Gegenstände';
          newLoreEntries.push({
            id: obj.loreEntryId || obj.id || `obj-lore-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`,
            category: targetCategory,
            title: objNameStr,
            description: obj.description || `${objNameStr} (Schauplatz auf der Karte${obj.x !== undefined ? ` bei X:${obj.x}, Y:${obj.y}` : ''})`,
            isUnlocked: true,
            details: {
              icon: obj.icon || '📍',
              mapLevel: 'micro',
              type: obj.category || 'Marker & Orte',
              coordinates: (obj.x !== undefined && obj.y !== undefined) ? { x: obj.x, y: obj.y } : undefined
            }
          });
          changed = true;
        }
      });
    });

    /* 4. Sync placedObjects from world.combatState or world.mapConfig if present */
    const globalObjects = [
