editForm.details?.worldReachability || 'direct'}
                        onChange={
e => updateDetail('worldReachability', e.target.value)}
                      >                        <option value="direct">Direkt erreichbar (Reise von A nach B ist unkompliziert möglich)</option>                        <option value="routing">Routenplanung / Umwege (Man muss erst über C reisen, um nach B zu kommen)</option>                      </select>                    </div>                    {/* Geografische Besonderheiten (Landschaftsmerkmale) */}
                    <div className="flex flex-col gap-1.5 sm:col-span-2">                      <label className="text-xs text-slate-400 font-bold uppercase">Geografische Merkmale der Weltkarte (Flüsse, Berge, Küsten, Wälder, Landflächen)</label>                      <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5">                        {/* Flüsse */}
                        <button                          type="button"                          onClick={() => updateDetail('worldHasRivers', !editForm.details?.worldHasRivers)}
                          className={
`p-3 rounded-xl border flex flex-col items-center justify-center text-center gap-1.5 transition-all cursor-pointer ${                            editForm.details?.worldHasRivers                              ? 'bg-sky-950/40 border-sky-500 text-sky-200'                              : 'bg-slate-950 border-slate-850 text-slate-500 hover:border-slate-800 hover:text-slate-400'                          }`}
                        >                          <i className="fa-solid fa-water text-sm"></i>                          <div className="flex flex-col">                            <span className="text-[10px] font-bold">🌊 Flüsse</span>                            <span className="text-[8px] text-slate-500">{
editForm.details?.worldHasRivers ? 'Vorhanden' : 'Keine'}
</span>                          </div>                        </button>                        {/* Berge */}
                        <button                          type="button"                          onClick={() => updateDetail('worldHasMountains', !editForm.details?.worldHasMountains)}
