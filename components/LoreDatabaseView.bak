        let cleanSeaName = part          .replace(/\b(?:im|in|nach|am|der|die|das|den)\s+(?:norden|süden|osten|westen|nord|süd|ost|west)\b/gi, '')          .replace(/^[,\s-–—:]+/, '')          .trim();
        if (!cleanSeaName || cleanSeaName.length < 2) cleanSeaName = `Meereszone ${pIdx + 1}`;
        if (lower.includes('norden') || lower.includes('nord')) {
