                        >                          <i className="fa-solid fa-umbrella-beach text-sm"></i>                          <div className="flex flex-col">                            <span className="text-[10px] font-bold">🏖️ Küsten</span>                            <span className="text-[8px] text-slate-500">{
editForm.details?.worldHasCoastlines ? 'Vorhanden' : 'Keine'}
</span>                          </div>                        </button>                        {/* Wälder */}
                        <button                          type="button"                          onClick={() => updateDetail('worldHasForests', !editForm.details?.worldHasForests)}
                          className={
