                      />                    </div>                  </div>                </div>              ) : (                
/* TAB 2: HIERARCHISCHE EBENEN */
                <div className="flex flex-col gap-5 animate-in fade-in duration-200">                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">                    {/* Zoom Level selection - first field under the map */}
                    <div className="flex flex-col gap-1.5 sm:col-span-2">                      <label className="text-xs text-amber-500 font-bold uppercase">Hierarchische Kategorie / Karten-Ebene</label>                      <select                         className="bg-slate-950 border border-slate-800 rounded-xl p-3 text-white text-sm w-full outline-none focus:border-amber-500 h-[48px] font-semibold"                        value={
editForm.details?.mapLevel || mapZoomLevel}
                        onChange={
e => {
