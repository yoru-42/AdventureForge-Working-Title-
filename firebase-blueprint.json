{
  "entities": {
    "TestConnection": {
      "title": "TestConnection",
      "description": "Connection test document",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Connection status"
        }
      }
    },
    "UserData": {
      "title": "UserData",
      "description": "User storage items such as settings, lore, etc.",
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "description": "Arbitrary synced data payload"
        }
      }
    },
    "Adventure": {
      "title": "Adventure",
      "description": "Individual adventure document",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique adventure identifier"
        }
      }
    }
  },
  "firestore": {
    "/test/connection": {
      "schema": "TestConnection",
      "description": "Connection test endpoint"
    },
    "/users/{userId}/data/{key}": {
      "schema": "UserData",
      "description": "User data key-value storage synced by StorageService"
    },
    "/users/{userId}/adventures/{advId}": {
      "schema": "Adventure",
      "description": "Individual user adventure documents synced by StorageService"
    }
  }
}
