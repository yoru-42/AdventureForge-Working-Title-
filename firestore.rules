rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing endpoint
    match /test/connection {
      allow read: if true;
    }

    // User data subcollection key-value storage
    match /users/{userId}/data/{key} {
      allow get, list, create, update, delete: if isOwner(userId) && isValidId(key);
    }

    // User adventures subcollection
    match /users/{userId}/adventures/{advId} {
      allow get, list, create, update, delete: if isOwner(userId) && isValidId(advId);
    }

    // Allow user root and any nested user paths
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
